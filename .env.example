# Postgres (host port 5433 -> container 5432)
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow

# Application
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=25000000

# Host ports (chosen to avoid clashing with other local stacks)
API_PORT=8001
FLOWER_PORT=5556
POSTGRES_PORT=5433
REDIS_PORT=6380
FRONTEND_PORT=3001

# Baked into the dashboard's client bundle at build time; must be reachable
# from the browser, not from inside the Docker network.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
