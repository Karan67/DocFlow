# Postgres (host port 5433 -> container 5432)
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow

# Application
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=25000000

# Host ports (chosen to avoid clashing with other local stacks)
API_PORT=8001
FLOWER_PORT=5556
POSTGRES_PORT=5433
REDIS_PORT=6380
FRONTEND_PORT=3001

# Baked into the dashboard's client bundle at build time; must be reachable
# from the browser, not from inside the Docker network.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Flower is an admin surface (it can revoke and terminate tasks). Change these
# before exposing it beyond localhost. They are checked by the flower-auth
# login page, not by Flower itself - Flower runs unauthenticated on the
# internal network and is not published to the host.
FLOWER_USER=admin
FLOWER_PASSWORD=admin
# Signs the login session cookie. Anyone who knows it can mint a valid session,
# so set a real random value outside local development:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOWER_SESSION_SECRET=dev-secret-change-me

# Storage: "local" uses the shared Docker volume, "s3" uses MinIO locally or
# real S3 in production (unset S3_ENDPOINT_URL for AWS).
STORAGE_BACKEND=local
S3_BUCKET=docflow-uploads
S3_ENDPOINT_URL=http://minio:9000
MINIO_ROOT_USER=docflow
MINIO_ROOT_PASSWORD=docflowsecret
AWS_REGION=us-east-1

# Number of trusted reverse proxies in front of the API. Leave at 0 unless
# there genuinely is one - see api/limiter.py for why.
TRUSTED_PROXY_COUNT=0
